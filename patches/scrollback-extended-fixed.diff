+/*
+ * Extend the existing selection to (col, row): the end closest to the
+ * click follows it, the other end stays put. The selection can then be
+ * dragged further like a fresh one. Returns 0 if there is nothing to
+ * extend.
+ */
+int
+selextendto(int col, int row, int type)
+{
+	long pos, dbeg, dend;
+
+	if (sel.ob.x == -1 || sel.mode != SEL_IDLE ||
+			sel.alt != IS_SET(MODE_ALTSCREEN))
+		return 0;
+
+	row += viewtop();
+	pos = (long)row * term.col + col;
+	dbeg = labs(pos - ((long)sel.nb.y * term.col + sel.nb.x));
+	dend = labs(pos - ((long)sel.ne.y * term.col + sel.ne.x));
+
+	seldirt(sel.nb.y, sel.ne.y);
+	sel.ob = (dbeg < dend) ? sel.ne : sel.nb;
+	sel.oe.x = col;
+	sel.oe.y = row;
+	sel.type = type;
+	selnormalize();
+	seldirt(sel.nb.y, sel.ne.y);
+	sel.mode = SEL_READY;
+
+	return 1;
+}
