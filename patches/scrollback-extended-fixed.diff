 }
 
+/* range of logical rows a selection can cover */
+static int
+selminrow(void)
+{
+	/* the alternate screen has no history */
+	return sel.alt ? sb.len : 0;
+}
+
+static int
+selmaxrow(void)
+{
+	return sb.len + term.row - 1;
+}
+
+/* mark the visible part of logical rows a..b dirty */
+static void
+seldirt(int a, int b)
+{
+	int top = viewtop();
+
+	a -= top;
+	b -= top;
+	if (b < 0 || a >= term.row)
+		return;
+	tsetdirt(MAX(a, 0), MIN(b, term.row - 1));
+}
+
+/* the oldest scrollback line was dropped: shift the selection with it */
+static void
+selevict(void)
+{
+	if (sel.ob.x == -1 || sel.alt)
+		return;
+
+	sel.ob.y--;
+	sel.oe.y--;
+	sel.nb.y--;
+	sel.ne.y--;
+
+	if (sel.ne.y < 0) {
+		selclear();
+		return;
+	}
+	if (sel.nb.y < 0)
+		sel.nb.x = sel.nb.y = 0;
+	if (sel.ob.y < 0)
+		sel.ob.x = sel.ob.y = 0;
+	if (sel.oe.y < 0)
+		sel.oe.x = sel.oe.y = 0;
+}
